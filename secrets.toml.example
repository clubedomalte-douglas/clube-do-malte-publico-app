# NAO suba este arquivo com valores reais para o GitHub.
# Copie o conteudo abaixo (com os valores reais) para dentro de:
# Streamlit Cloud -> seu app -> Settings -> Secrets
#
# Localmente (se quiser rodar no seu PC), salve como .streamlit/secrets.toml
# na raiz do projeto - esse caminho ja esta no .gitignore, nao vai pro Git.
#
# Sem isso configurado, o app cai de volta pro upload manual da RD Station
# na barra lateral, sem quebrar nada.

# ID numerico da propriedade GA4 "Clube do Malte | GA4" (Admin -> Detalhes da propriedade)
GA4_PROPERTY_ID = "190526741"

# ID numerico da audiencia "Navegou Recente (360 dias)" (Admin -> Publicos-alvo -> clique
# na audiencia -> o numero aparece na URL, ex.: .../audiences/12 -> AUDIENCE_ID = "12")
GA4_AUDIENCE_ID = "12"

# Campos da chave JSON da service account (Google Cloud -> IAM -> Contas de servico ->
# ga4-app-reader@clube-do-malte-reposicao.iam.gserviceaccount.com -> aba Chaves).
# Copie cada campo do arquivo .json baixado para dentro do bloco abaixo.
[ga4_service_account]
type = "service_account"
project_id = "clube-do-malte-reposicao"
private_key_id = "cole_aqui"
private_key = "-----BEGIN PRIVATE KEY-----\ncole_aqui\n-----END PRIVATE KEY-----\n"
client_email = "ga4-app-reader@clube-do-malte-reposicao.iam.gserviceaccount.com"
client_id = "cole_aqui"
token_uri = "https://oauth2.googleapis.com/token"
